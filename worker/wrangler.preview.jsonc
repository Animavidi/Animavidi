{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "animavidi-beta",
  "main": "src/preview.ts",
  "account_id": "b775aad4f66b51091e4b1467896a0a4a",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"../dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/media/*"]},
  "d1_databases": [{"binding":"CONTENT_DB","database_name":"animavidi-beta-content","database_id":"590d8dc0-5132-4088-9e43-350f0cf489e1","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MAMMAL_PHOTOS","bucket_name":"animavidi-beta-photos"}]
}
