{
  "name": "animavidi",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build --configLoader runner && node scripts/build-pwa.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "test:auth-rate-limit": "node scripts/test-auth-rate-limit.mjs",
    "test:pwa-update": "node scripts/test-pwa-update.mjs",
    "test:resend": "node scripts/test-resend.mjs",
    "test:accounts": "pnpm build:preview && node scripts/test-resend.mjs && node scripts/test-user-cloud.mjs && node scripts/test-accounts-browser.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p worker/tsconfig.json --pretty false",
    "validate:mammal-images": "node scripts/validate-mammal-images.mjs",
    "validate:mammal-dataset": "node scripts/validate-mammal-dataset.mjs",
    "validate:animal-detail": "node scripts/validate-animal-detail.mjs",
    "validate:sighting-flow": "node scripts/validate-sighting-flow.mjs",
    "validate:big-five-celebration": "node scripts/validate-big-five-celebration.mjs",
    "validate:species-achievements": "node scripts/validate-species-achievements.mjs",
    "validate:content-admin": "node scripts/validate-content-admin.mjs",
    "admin:hash-password": "node scripts/generate-admin-password-hash.mjs",
    "validate:kruger-content": "node scripts/validate-kruger-content.mjs",
    "validate:safari-routes": "node scripts/validate-safari-routes.mjs",
    "validate:bird-proposals": "node scripts/validate-bird-proposals.mjs",
    "validate:starter-birds": "node scripts/validate-starter-birds.mjs",
    "validate:release-starter-images": "node scripts/validate-release-images.mjs --scope=starter",
    "validate:release-images": "node scripts/validate-release-images.mjs",
    "validate:reviewed-photos": "node scripts/validate-reviewed-photos.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.64.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "wrangler": "^4.127.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
